{
  "name": "autonomo-core",
  "version": "2.0.1",
  "description": "Framework-agnostic core for Autonomo test bridges",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "keywords": [
    "autonomo",
    "ai",
    "testing",
    "mcp"
  ],
  "author": "Jason Sebring",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebringj/autonomo.git",
    "directory": "packages/autonomo-core"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@autonomo/react-native",
  "version": "1.0.0",
  "description": "React Native integration for Autonomo with Expo support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@autonomo/core": "workspace:*",
    "@autonomo/react": "workspace:*",
    "expo-constants": ">=14.0.0",
    "react": "^18.0.0",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo-constants": {
      "optional": true
    }
  },
  "devDependencies": {
    "@autonomo/core": "workspace:*",
    "@autonomo/react": "workspace:*",
    "@types/react": "^19.2.14",
    "react": "^19.2.4",
    "react-native": "^0.84.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "react-native",
    "expo",
    "autonomo",
    "ai",
    "testing"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebringj/autonomo.git"
  }
}

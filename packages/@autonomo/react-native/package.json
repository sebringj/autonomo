{
  "name": "@autonomo/react-native",
  "version": "0.1.0",
  "description": "React Native integration for Autonomo with Expo support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@autonomo/core": "workspace:*",
    "@autonomo/react": "workspace:*",
    "react": "^18.0.0",
    "react-native": "*"
  },
  "devDependencies": {
    "@autonomo/core": "workspace:*",
    "@autonomo/react": "workspace:*",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-native": "^0.74.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "react-native",
    "expo",
    "autonomo",
    "ai",
    "testing"
  ],
  "author": "",

{
  "name": "@autonomo/angular",
  "version": "1.0.0",
  "description": "Angular service and directives for Autonomo integration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "peerDependencies": {
    "@angular/core": ">=16.0.0",
    "@angular/common": ">=16.0.0",
    "@autonomo/core": "workspace:*",
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "@angular/core": "^18.0.0",
    "@angular/common": "^18.0.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "rxjs": "^7.8.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "angular",
    "autonomo",
    "ai",
    "testing"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebringj/autonomo.git",
    "directory": "packages/@autonomo/angular"
  }
}
